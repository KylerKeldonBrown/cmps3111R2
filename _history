 . . . c b f 2 2 2 2 f b c . . .\n            . . . c b f 2 1 2 2 f b c . . .\n            . . . c b b f f f f b b c . . .\n            . . . . c b b b b b b c . . . .\n            . . . . . c c c c c c . . . . .\n            . . . . . . . 2 2 . . . . . . .\n            . . . . . . 2 . . 2 . . . . . .\n            . . . . . 2 . . . . 2 . . . . .\n        `\n        // helper costume: green light and blue body; off costume: all grey\n        this.helperImage = scanImage.clone()\n        this.helperImage.replace(2, 7)\n        this.helperImage.replace(11, 9)\n        this.offImage = scanImage.clone()\n        this.offImage.replace(2, 12)\n        this.sprite = sprites.create(scanImage, SpriteKind.Drone)\n        this.sprite.setPosition(x, y)\n        allDrones.push(this)\n    }\n\n    // Follow the student around the screen\n    chase(target: Sprite) {\n        this.sprite.follow(target, this.speed)\n    }\n\n    // Called when the drone touches Maya: it raises a false alarm\n    falseFlag(student: Student) {\n        this.flagsRaised += 1\n        const score = randint(88, 97)\n        this.sprite.sayText(\"FLAGGED \" + score + \"%!\", 1000, false)\n        student.penalty(1, \"I wrote it myself!\")\n        // bounce back to a random corner so the player can recover\n        this.sprite.setPosition(randint(0, 1) * 150 + 5, randint(0, 1) * 80 + 30)\n    }\n\n    powerDown() {\n        this.sprite.follow(null)\n        this.sprite.setVelocity(0, 0)\n        this.sprite.setImage(this.offImage)\n        this.sprite.sayText(\"...\", 800, false)\n    }\n\n    becomeHelper() {\n        this.sprite.setImage(this.helperImage)\n        this.sprite.startEffect(effects.confetti, 500)\n    }\n\n    static find(s: Sprite): DetectorDrone {\n        for (let p = 0; p < allDrones.length; p++) {\n            if (allDrones[p].sprite == s) return allDrones[p]\n        }\n        return null\n    }\n"]]},{"start1":20982,"length1":0,"diffs":[[1,"class RightToken {\n    sprite: Sprite\n    name: string\n"]]},{"start1":21038,"length1":0,"diffs":[[1,"    constructor(name: string) {\n        this.name = name\n        this.sprite = sprites.create(img`\n            . 7 7 7 7 7 7 7 7 .\n            7 7 1 1 7 7 1 1 7 7\n            7 1 1 1 1 1 1 1 1 7\n            7 7 1 1 1 1 1 1 7 7\n            7 7 7 1 1 1 1 7 7 7\n            . 7 7 7 1 1 7 7 7 .\n            . . 7 7 7 7 7 7 . .\n            . . . 7 7 7 7 . . .\n            . . . . 7 7 . . . .\n        `, SpriteKind.Right)\n        this.sprite.setPosition(randint(15, 145), randint(30, 105))\n        this.sprite.lifespan = 7000\n        this.sprite.startEffect(effects.halo, 7000)\n    }\n}\nlet rightNames = [\n\"Right to Privacy\",\n\"Right to Dignity\",\n\"Right to a Fair Hearing\",\n\"Right to Education\",\n\"Right to Be Heard\",\n\"Freedom of Expression\"\n]\n"]]},{"start1":21846,"length1":45,"diffs":[[1,"// MAIN STORY\n"]]},{"start1":21933,"length1":182,"diffs":[[1,"info.setScore(0)\n// ----- Title & Scene 1: the classroom -----\nscene.setBackgroundImage(titleBackground())\nStory.say(\"Narrator\", \"AI tools are everywhere in Belize - in phones, homes and schools.\", 4)\nStory.say(\"Narrator\", \"Meet Maya, a student in Belize City, facing a tempting shortcut.\", 4)\nscene.setBackgroundImage(classroomBackground(\"History Essay\", \"Due: FRIDAY\"))\nteacher = new Teacher()\nteacher.sprite.setPosition(16, 48)\nmaya = new Student()\nmaya.sprite.setPosition(146, 54)\nteacher.say(\"Class, write an essay on Belize's independence: 21 September 1981.\")\nmaya.say(\"Miss, can AI just write it for us?\")\nteacher.say(\"AI can help you learn - but passing off AI work as yours is cheating.\")\nteacher.say(\"Start the right way: use real sources!\")\n// ----- Level 1: Research the Right Way -----\nscene.setBackgroundImage(libraryBackground())\nteacher.sprite.setFlag(SpriteFlag.Invisible, true)\nStory.say(\"LEVEL 1: Research\", \"Use the arrow keys. Grab blue BOOKS (+1). Avoid white AI essays (-2)!\", 7)\nmaya.sprite.setPosition(80, 80)\nplayLevel(1, 30)\nsprites.destroyAllSpritesOfKind(SpriteKind.GoodSource)\nsprites.destroyAllSpritesOfKind(SpriteKind.Shortcut)\n// ----- Scene 2: late night with the GenAI robot -----\nscene.setBackgroundImage(nightBackground())\nmaya.sprite.setPosition(40, 56)\nStory.say(\"Narrator\", \"Thursday night in Belmopan. The essay is due tomorrow...\", 4)\nmaya.say(\"AI, write my whole essay for me!\")\nrobot = new GenAIRobot()\nrobot.sprite.setPosition(118, 50)\nrobot.say(\"Then it wouldn't be YOUR work. I'll help you learn instead.\")\nrobot.say(\"Warning: I learned mostly about OTHER countries. I can be biased about Belize.\")\nStory.say(\"LEVEL 2: Fact or Bias?\", \"Read each AI claim. CATCH true facts (+2). DODGE biased claims (-1)!\", 7)\nmaya.sprite.setPosition(80, 100)\nrobot.patrol()\nplayLevel(2, 35)\nrobot.stop()\nStory.clearBanner()\nsprites.destroyAllSpritesOfKind(SpriteKind.Claim)\nrobot.glitch()\nrobot.say(\"You caught my mistakes! Always check AI with trusted sources.\")\nmaya.say(\"AI is a tool for thinking - not a replacement for it.\")\nrobot.sprite.setFlag(SpriteFlag.Invisible, true)\n// ----- Scene 3 + Level 3: Rights, Not Surveillance -----\nscene.setBackgroundImage(hallwayBackground())\nmaya.sprite.setPosition(80, 80)\nStory.say(\"Narrator\", \"Friday. AI detector drones now scan every student's essay.\", 4)\nStory.say(\"Detector\", \"NON-STANDARD ENGLISH = SUSPICIOUS. YOU ARE BEING WATCHED.\", 2)\nmaya.say(\"Jaden writes in Kriol style - and they flagged him for cheating!\")\nconst d1 = new DetectorDrone(10, 30, 22)\nconst d2 = new DetectorDrone(150, 30, 26)\nconst d3 = new DetectorDrone(150, 110, 30)\nStory.say(\"LEVEL 3: Your Rights\", \"Dodge the drones! Collect green HUMAN RIGHTS shields (+2).\", 7)\nfor (let f of allDrones) {\n    f.chase(maya.sprite)\n}\nplayLevel(3, 30)\nsprites.destroyAllSpritesOfKind(SpriteKind.Right)\nfor (let g of allDrones) {\n    g.powerDown()\n}\n// ----- Ending: the class AI agreement -----\nscene.setBackgroundImage(classroomBackground(\"Our Class\", \"AI Agreement\"))\nteacher.sprite.setFlag(SpriteFlag.Invisible, false)\nteacher.sprite.setPosition(16, 48)\nmaya.sprite.setPosition(146, 54)\nStory.moveTo(d1.sprite, 50, 8, 400)\nStory.moveTo(d2.sprite, 80, 8, 400)\nStory.moveTo(d3.sprite, 110, 8, 400)\nteacher.say(\"Stop! A detector score is not proof. This one is biased against Kriol.\")\nteacher.say(\"A Human Rights-Based Approach means privacy, dignity and a fair hearing for all.\")\nteacher.announceRules()\nfor (let s of allDrones) {\n    s.becomeHelper()\n}\nStory.say(\"Helper drones\", \"Rebooted as AI Literacy Helpers: here to TEACH, not to watch.\", 7)\nmaya.say(\"Here's my essay - and a note on how I used AI to brainstorm.\")\nteacher.say(\"Excellent, Maya. That's responsible AI use.\")\nStory.say(\"Result\", \"Integrity points: \" + maya.integrity + \". Rating: \" + maya.rating(), 5)\nStory.say(\"Narrator\", \"Use AI to learn, not to replace learning!\", 4)\ngame.over(true)\n// ---------- Level 2 events ----------\ngame.onUpdateInterval(4200, function () {\n    if (level == 2) {\n        robot.fireClaim()\n    }\n})\ngame.onUpdateInterval(3500, function () {\n    if (level == 3) {\n        allRights.push(new RightToken(rightNames[randint(0, rightNames.length - 1)]))\n    }\n})\n// ---------- Level 1 events ----------\ngame.onUpdateInterval(900, function () {\n    if (level == 1) {\n        new Source(Math.percentChance(60))\n    }\n})\n"]]}]}]},{"timestamp":1794884806693,"editorVersion":"4.1.28","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":709,"length1":0,"diffs":[[1,"let bannerOn = false\nlet dialogBox: TextSprite = null\nlet banner: TextSprite = null\n"]]},{"start1":819,"length1":217,"diffs":[[1,""]]},{"start1":1680,"length1":110,"diffs":[[1,"    mayaReward(1, sprites.readDataString(otherSprite, \"label\") + \"!\")\n"]]},{"start1":1877,"length1":119,"diffs":[[1,"    mayaPenalty(2, \"No \" + sprites.readDataString(otherSpr