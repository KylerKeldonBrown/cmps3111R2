tudent in Belize City, facing a tempting shortcut.\")\n}\n\nfunction sceneClassroom() {\n    teacher.setFlag(SpriteFlag.Invisible, false)\n    teacher.setPosition(16, 48)\n    maya.setPosition(146, 54)\n    classroomBackground(\"History Essay\", \"Due: FRIDAY\")\n    teacherSay(\"Class, write an essay on Belize's independence: 21 September 1981.\")\n    mayaSay(\"Miss, can AI just write it for us?\")\n    teacherSay(\"AI can help you learn - but passing off AI work as yours is cheating.\")\n    teacherSay(\"Start the right way: use real sources!\")\n}\n\nfunction level1Research() {\n    clearScene()\n    scene.setBackgroundColor(13)\n    layTiles(2, 8, 20, 10)\n    layTiles(2, 8, 44, 10)\n    layFloor()\n    teacher.setFlag(SpriteFlag.Invisible, true)\n    say(\"LEVEL 1: Research\", \"Use the arrow keys. Grab blue BOOKS (+1). Avoid white AI essays (-2)!\")\n    maya.setPosition(80, 80)\n    playLevel(1, 30)\n    sprites.destroyAllSpritesOfKind(SpriteKind.GoodSource)\n    sprites.destroyAllSpritesOfKind(SpriteKind.Shortcut)\n}\n\nfunction sceneNightIntro() {\n    clearScene()\n    scene.setBackgroundColor(8)\n    layFloor()\n    layTiles(5, 24, 28, 3)\n    layTiles(5, 24, 44, 3)\n    maya.setPosition(40, 56)\n    say(\"Narrator\", \"Thursday night in Belmopan. The essay is due tomorrow...\")\n    mayaSay(\"AI, write my whole essay for me!\")\n    createRobot()\n    robot.setPosition(118, 50)\n    robotSay(\"Then it wouldn't be YOUR work. I'll help you learn instead.\")\n    robotSay(\"Warning: I learned mostly about OTHER countries. I can be biased about Belize.\")\n}\n\nfunction level2FactOrBias() {\n    say(\"LEVEL 2: Fact or Bias?\", \"Read each AI claim. CATCH true facts (+2). DODGE biased claims (-1)!\")\n    maya.setPosition(80, 100)\n    robotPatrol()\n    playLevel(2, 35)\n    robotStop()\n    sprites.destroyAllSpritesOfKind(SpriteKind.Claim)\n}\n\nfunction sceneNightOutro() {\n    robotGlitchEffect()\n    robotSay(\"You caught my mistakes! Always check AI with trusted sources.\")\n    mayaSay(\"AI is a tool for thinking - not a replacement for it.\")\n    robot.setFlag(SpriteFlag.Invisible, true)\n}\n\nfunction sceneHallwayIntro() {\n    clearScene()\n    scene.setBackgroundColor(13)\n    layTiles(3, 8, 28, 10)\n    layTiles(3, 8, 44, 10)\n    layTiles(3, 8, 60, 10)\n    layTiles(3, 8, 76, 10)\n    layFloor()\n    maya.setPosition(80, 80)\n    say(\"Narrator\", \"Friday. AI detector drones now scan every student's essay.\")\n    say(\"Detector\", \"NON-STANDARD ENGLISH = SUSPICIOUS. YOU ARE BEING WATCHED.\")\n    mayaSay(\"Jaden writes in Kriol style - and they flagged him for cheating!\")\n    createDrone(10, 30, 22)\n    createDrone(150, 30, 26)\n    createDrone(150, 110, 30)\n}\n\nfunction level3Rights() {\n    say(\"LEVEL 3: Your Rights\", \"Dodge the drones! Collect green HUMAN RIGHTS shields (+2).\")\n    playLevel(3, 30)\n    sprites.destroyAllSpritesOfKind(SpriteKind.Right)\n    dronesPowerDown()\n}\n\nfunction sceneEnding() {\n    teacher.setFlag(SpriteFlag.Invisible, false)\n    teacher.setPosition(16, 48)\n    maya.setPosition(146, 54)\n    classroomBackground(\"Our Class\", \"AI Agreement\")\n    glideDrone(0, 50, 8, 400)\n    glideDrone(1, 80, 8, 400)\n    glideDrone(2, 110, 8, 400)\n    teacherSay(\"Stop! A detector score is not proof. This one is biased against Kriol.\")\n    teacherSay(\"A Human Rights-Based Approach means privacy, dignity and a fair hearing for all.\")\n    announceRules()\n    dronesBecomeHelpers()\n    say(\"Helper drones\", \"Rebooted as AI Literacy Helpers: here to TEACH, not to watch.\")\n    mayaSay(\"Here's my essay - and a note on how I used AI to brainstorm.\")\n    teacherSay(\"Excellent, Maya. That's responsible AI use.\")\n    say(\"Result\", \"Integrity points: \" + integrity + \". Rating: \" + mayaRating())\n    say(\"Narrator\", \"Use AI to learn, not to replace learning!\")\n}\n\n// =====================================================================\n// MAIN STORY: ju