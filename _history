mayaSay\" functionid=\"+TW|w/`y^RmxsL5vYlJ!\"><arg name=\"text\" id=\"5if570zlsdu8bbcxv9iedt\" type=\"string\"></arg></mutation><value name=\"5if570zlsdu8bbcxv9iedt\"><shadow type=\"text\"><field name=\"TEXT\">Here's my essay - and a note on how I used AI to brainstorm.</field></shadow></value><next><block type=\"function_call\"><mutation name=\"teacherSay\" functionid=\";YJL}+~6C+J~xEO[p/1_\"><arg name=\"text\" id=\"8m7o8k3fsv5fpsxvyvbyf\" type=\"string\"></arg></mutation><value name=\"8m7o8k3fsv5fpsxvyvbyf\"><shadow type=\"text\"><field name=\"TEXT\">Excellent, Maya. That's responsible AI use.</field></shadow></value><next><block type=\"function_call\"><mutation name=\"say\" functionid=\"fPM./11#p$}U0h{qf(]]\"><arg name=\"speaker\" id=\"u8ri6uazp6fli4krctve\" type=\"string\"></arg><arg name=\"text\" id=\"i5z6z6c9k5sjmauzfbh3k\" type=\"string\"></arg></mutation><value name=\"u8ri6uazp6fli4krctve\"><shadow type=\"text\"><field name=\"TEXT\">Result</field></shadow></value><value name=\"i5z6z6c9k5sjmauzfbh3k\"><shadow type=\"text\"><field name=\"TEXT\">abc</field></shadow><block type=\"text_join\"><mutation items=\"4\"></mutation><value name=\"ADD0\"><shadow type=\"text\"><field name=\"TEXT\">Integrity points: </field></shadow></value><value name=\"ADD1\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"uj$^i4ka4XGXhJ]/7@Jm\">integrity</field></block></value><value name=\"ADD2\"><shadow type=\"text\"><field name=\"TEXT\">. Rating: </field></shadow></value><value name=\"ADD3\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow><block type=\"function_call_output\"><mutation name=\"mayaRating\" functionid=\"~1JF[P87lGA*~vFv!45S\"></mutation></block></value></block></value><next><block type=\"function_call\"><mutation name=\"say\" functionid=\"fPM./11#p$}U0h{qf(]]\"><arg name=\"speaker\" id=\"u8ri6uazp6fli4krctve\" type=\"string\"></arg><arg name=\"text\" id=\"i5z6z6c9k5sjmauzfbh3k\" type=\"string\"></arg></mutation><value name=\"u8ri6uazp6fli4krctve\"><shadow type=\"text\"><field name=\"TEXT\">Narrator</field></shadow></value><value name=\"i5z6z6c9k5sjmauzfbh3k\"><shadow type=\"text\"><field name=\"TEXT\">Use AI to learn, not to replace learning!</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type=\"function_definition\" x=\"20\" y=\"6407\"><mutation name=\"playLevel\" functionid=\"+-d)5},.TU?;npz_*Igy\"><arg name=\"n\" id=\"ooql55pxp82lpq1idlfb\" type=\"number\"></arg><arg name=\"seconds\" id=\"awy974dhtm4m0f1y2klyn\" type=\"number\"></arg></mutation><field name=\"function_name\">playLevel</field><comment pinned=\"false\" h=\"80\" w=\"160\">run one timed level</comment><value name=\"ooql55pxp82lpq1idlfb\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">n</field></block></value><value name=\"awy974dhtm4m0f1y2klyn\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">seconds</field></block></value><statement name=\"STACK\"><block type=\"function_call\"><mutation name=\"enableControls\" functionid=\"f_Dzd!Hb?2(RBz9dms+-\"></mutation><next><block type=\"variables_set\"><field name=\"VAR\" id=\")~#UN[FMTcTA[F!d`{pN\">level</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"argument_reporter_number\"><field name=\"VALUE\">n</field></block></value><next><block type=\"gamecountdown\"><value name=\"duration\"><block type=\"argument_reporter_number\"><field name=\"VALUE\">seconds</field></block></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow><block type=\"math_arithmetic\"><field name=\"OP\">MULTIPLY</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"argument_reporter_number\"><field name=\"VALUE\">seconds</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1000</field></shadow></value></block></value><next><block type=\"gamestopcountdown\"><next><block type=\"variables_set\"><field name=\"VAR\" id=\")~#UN[FMTcTA[F!d`{pN\">level</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"function_call\"><mutation name=\"disableControls\" functionid=\";E1Wl}V_?d9veAb-Fz{M\"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"namespace SpriteKind {\n    export const NPC = SpriteKind.create()\n    export const GoodSource = SpriteKind.create()\n    export const Shortcut = SpriteKind.create()\n    export const Claim = SpriteKind.create()\n    export const Drone = SpriteKind.create()\n    export const Right = SpriteKind.create()\n}\n\n// =====================================================================\n// GLOBAL VARIABLES\n// =====================================================================\nlet maya: Sprite = null\nlet teacher: Sprite = null\nlet robot: Sprite = null\nlet integrity = 0\nlet level = 0            // 0 = cut-scene, 1-3 = playing that level\nlet lastHit = 0\nlet nextClaim = 0\nlet drones: Sprite[] = []\nlet droneSpeeds: number[] = []\nlet srcSprites: Sprite[] = []\nlet srcLabels: string[] = []\nlet bubbleSprites: Sprite[] = []\nlet bubbleClaims: number[] = []\nlet tokenSprites: Sprite[] = []\nlet tokenNames: string[] = []\nlet rules: string[] = []\nlet rightNames: string[] = []\nlet goodNames: string[] = []\nlet badNames: string[] = []\nlet claimTexts: string[] = []\nlet claimTrue: boolean[] = []\nlet claimFix: string[] = []\nlet robotNormal: Image = null\nlet robotGlitch: Image = null\nlet droneHelper: Image = null\nlet droneOff: Image = null\n\n// =====================================================================\n// EVENTS\n// =====================================================================\n// stop the countdown from ending the game - the story controls when levels end\ninfo.onCountdownEnd(function () {\n})\n\n// ---------- Level 1 events ----------\nsprites.onOverlap(SpriteKind.Player, SpriteKind.GoodSource, function (sprite, otherSprite) {\n    let n = srcSprites.indexOf(otherSprite)\n    if (n >= 0) {\n        mayaReward(1, srcLabels[n] + \"!\")\n    }\n    sprites.destroy(otherSprite)\n})\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Shortcut, function (sprite, otherSprite) {\n    let n = srcSprites.indexOf(otherSprite)\n    if (n >= 0) {\n        mayaPenalty(2, \"No \" + srcLabels[n] + \"!\")\n    }\n    sprites.destroy(otherSprite)\n})\ngame.onUpdateInterval(650, function () {\n    if (level == 1) {\n        spawnSource(Math.percentChance(50))\n    }\n})\n\n// ---------- Level 2 events ----------\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Claim, function (sprite, otherSprite) {\n    let n = bubbleSprites.indexOf(otherSprite)\n    sprites.destroy(otherSprite)\n    if (n < 0) {\n        return\n    }\n    let idx = bubbleClaims[n]\n    if (claimTrue[idx]) {\n        mayaReward(2, \"Verified!\")\n    } else {\n        mayaPenalty(1, \"Biased!\")\n        robot.sayText(claimFix[idx], 3500, false)\n    }\n})\ngame.onUpdateInterval(3000, function () {\n    if (level == 2) {\n        fireClaim()\n    }\n})\n\n// ---------- Level 3 events ----------\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Right, function (sprite, otherSprite) {\n    let n = tokenSprites.indexOf(otherSprite)\n    if (n >= 0) {\n        mayaReward(2, tokenNames[n] + \"!\")\n    }\n    sprites.destroy(otherSprite)\n})\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Drone, function (sprite, otherSprite) {\n    // protection after each hit\n    if (game.runtime() - lastHit < 1000) {\n        return\n    }\n    lastHit = game.runtime()\n    falseFlag(otherSprite)\n})\ngame.onUpdateInterval(2800, function () {\n    if (level == 3) {\n        spawnRight()\n    }\n})\n// drones chase Maya during level 3\ngame.onUpdate(function () {\n    if (level == 3) {\n        for (let i = 0; i < drones.length; i++) {\n            let dr = drones[i]\n            let dx = maya.x - dr.x\n            let dy = maya.y - dr.y\n            let dist = Math.max(1, Math.sqrt(dx * dx + dy * dy))\n            dr.setVelocity(dx / dist * droneSpeeds[i], dy / dist * droneSpeeds[i])\n        }\n    }\n})\n\n// =====================================================================\n// DIALOGUE (built-in dialog box, press A to continue)\n// =====================================================================\nfunction say(speaker: string, text: string) {\n    game.showLongText(speaker + \": \" + text, DialogLayout.Bottom)\n}\nfunction mayaSay(text: string) {\n    say(\"Maya\", text)\n}\nfunction teacherSay(text: string) {\n    say(\"Ms. Flores\", text)\n}\nfunction robotSay(text: string) {\n    say(\"GenAI Robot\", text)\n}\n\n// =====================================================================\n// MAYA (student) HELPERS\n// =====================================================================\nfunction mayaReward(points: number, message: string) {\n    info.changeScoreBy(points)\n    integrity += points\n    maya.sayText(message, 900, false)\n    maya.startEffect(effects.hearts, 300)\n}\nfunction mayaPenalty(points: number, message: string) {\n    info.changeScoreBy(0 - points)\n    integrity -= points\n    maya.sayText(message, 1200, false)\n    scene.cameraShake(3, 300)\n}\nfunction mayaRating(): string {\n    if (integrity >= 30) {\n        return \"AI Literacy Champion\"\n    }\n    if (integrity >= 15) {\n        return \"Responsible AI User\"\n    }\n    return \"Still Learning - and that's okay!\"\n}\nfunction enableControls() {\n    controller.moveSprite(maya, 75, 75)\n    maya.s